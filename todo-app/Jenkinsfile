pipeline {
    agent any

    environment {
        BACKEND_IMAGE  = "todo-backend"
        FRONTEND_IMAGE = "todo-frontend"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling latest code from GitHub...'
                checkout scm
            }
        }

        stage('Build Backend') {
            steps {
                echo 'Building Flask backend Docker image...'
                bat 'docker build -t %BACKEND_IMAGE% todo-app/backend'
            }
        }

        stage('Build Frontend') {
            steps {
                echo 'Building React frontend Docker image...'
                bat 'docker build -t %FRONTEND_IMAGE% todo-app/frontend'
            }
        }

        stage('Test Backend') {
            steps {
                echo 'No tests defined yet — skipping.'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying containers...'
                bat 'docker-compose -f todo-app/docker-compose.yml down || exit 0'
                bat 'docker-compose -f todo-app/docker-compose.yml up -d'
            }
        }
    }

    post {
        success {
            echo 'Pipeline succeeded! App is running.'
        }
        failure {
            echo 'Pipeline failed. Check the logs above.'
        }
    }
}